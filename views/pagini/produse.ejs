<!DOCTYPE html>
<html  lang="ro">
    <head>
        <title>Produse</title>

        <meta name="keywords" content="gust, ingrediente, ingrediente proaspete, produse bio, condimente, fructe, legume, carne, lactate, rețete, deserturi, deserturi fără zahăr">
        <meta name="description" content="La GustoMarket poți cumpăra cele mai proaspete ingrediente pentru a realiza cele mai delicioase rețete. Livrare la domiciliu doar în București!">
        <link rel="stylesheet" type="text/css" href="/resurse/css/produse.css">
        <script type="text/javascript" src=/resurse/js/produse.js></script>

        <%- include("../fragmente/head.ejs");  %> 
    </head>
    <body>
        
    <%- include("../fragmente/header.ejs");  %> 

    <main>
        <h2>Produse</h2>
        <section id="produse">
            <label>Nume: 
                <input type="text" id="inp-nume" list="nume-produse" />
            </label>
            <label>Tara de origine: 
                <input type="text" id="inp-tara" list="tara-produse" />
            </label>
            <datalist id="nume-produse">
                <% for (let prod of locals.produse) { %>
                    <option value="<%= prod.nume %>"></option>
                <% } %>
            </datalist>
            
            <label>Gramaj minim: <input type="range" id="inp-gramaj" value="0" min="0" max="1000" step="50">
            <span id="infoRange">(0)</span></label>

            <label>Categorie produs:
                <select id="inp-categorie" name="tip_produs">
                <option value="oricare" selected>Oricare</option>
                <option value="legume">Legume</option>
                <option value="fructe">Fructe</option>
                <option value="lactate">Lactate si oua</option>
                <option value="cereale">Paine si Cereale</option>
                <option value="carne">Carne</option>
                </select>
            </label>

            <div>Alege tipul de ambalaj:
                <p><label>Vidat
                    <input id="ambalaj_vidat" name="tip_ambalaj" value="vidat" type="radio" />
                </label></p>
                <p><label>Cutie
                    <input id="ambalaj_cutie" name="tip_ambalaj" value="cutie" type="radio" />
                </label></p>
                <p><label>Punga
                    <input id="ambalaj_punga" name="tip_ambalaj" value="punga" type="radio" />
                </label></p>
                <p><label>Sticla
                    <input id="ambalaj_sticla" name="tip_ambalaj" value="sticla" type="radio" />
                </label></p>
                <p><label>Neambalat
                    <input id="ambalaj_neambalat" name="tip_ambalaj" value="neambalat" type="radio"/>
                </label></p>
                <p><label>Oricare
                    <input id="ambalaj_oricare" name="tip_ambalaj" value="oricare" type="radio" checked/>
                </label></p>
            </div>

            <label>Filtrează după perioada până la expirare:
                <select id="inp-data-expirare" name="data-exipare" multiple>
                <option value="0-3">0-3 luni</option>
                <option value="3-6">3-6 luni</option>
                <option value="6-12">6-12 luni</option>
                <option value="12+">Peste 12 luni</option>
                </select>
            </label>
            
            <div>
                <p>Vegan:</p>
                <label>
                    <input type="radio" name="vegan" value="toate" checked> Toate
                </label>
                <label>
                    <input type="radio" name="vegan" value="da"> Da
                </label>
                <label>
                    <input type="radio" name="vegan" value="nu"> Nu
                </label>
            </div>

            <label>
                <textarea id="inp-caracteristici" placeholder="Caracteristici (ex: proaspete, bio, etc.)"></textarea>
            </label>


            <p>
                <button class="c1 c2 c3" id="filtrare">Filtreaza</button> 
                <button id="resetare">Reseteaza</button><br/>
                <button id="sortCrescNume">Sorteaza crescator dupa pret si nume</button>
                <button id="sortDescrescNume">Sorteaza descrescator dupa pret si nume</button>
                <button id="calcSuma">Calculeaza suma produselor selectate</button>
            </p>
            <p id="p-suma"></p>

            <div class="grid-produse">
                <% for( let prod of locals.produse) { %>
                    <article class="produs" id="elem_">
                        <h3 class="nume">Nume: <a href="/produs/<%-prod.id %>" ><span class="val-nume"><%- prod.nume%></span></a></h3>
                        <div class="container-info-img">
                            <table class="info-prod">
                                <tr>
                                    <th>Pret</th>
                                    <th><span class="val-pret"><%- prod.pret%></span></th>
                                </tr>
                                <tr>
                                    <th>Tara</th>
                                    <th><span class="val-tara"><%- prod.tara%></span></th>
                                </tr>
                                <tr>
                                    <th>Caracteristici</th>
                                    <th><span class="val-caracteristici"><%- prod.caracteristici%></span></th>
                                </tr>
                                <tr>
                                    <th>Data exiprare</th>
                                    <th>
                                        <time class="val-data-expirare" datetime="<%= prod.data_expirare %>">
                                            <script>
                                                function capitalize(str) {
                                                    return str.charAt(0).toUpperCase() + str.slice(1);
                                                }

                                                document.querySelectorAll('time.val-data-expirare').forEach(el => {
                                                    const dateStr = el.getAttribute('datetime');
                                                    if (dateStr) {
                                                    const date = new Date(dateStr);
                                                    if (!isNaN(date)) {
                                                        const zi = date.getDate();
                                                        const luna = date.toLocaleDateString('ro-RO', { month: 'long' });
                                                        const an = date.getFullYear();
                                                        const ziSapt = date.toLocaleDateString('ro-RO', { weekday: 'long' });
                                                        el.textContent = `${zi} ${capitalize(luna)} ${an} (${capitalize(ziSapt)})`;
                                                    } else {
                                                        el.textContent = 'N/A';
                                                    }
                                                    } else {
                                                    el.textContent = 'N/A';
                                                    }
                                                });
                                            </script>
                                        </time>
                                    </th>
                                </tr>
                                <tr>
                                    <th>Vegan</th>
                                    <th><span class="val-vegan"><%- prod.vegan ? "Da" : "Nu" %></span></th>
                                </tr>
                            </table>
                            <figure>
                                <a href="/produs/<%-prod.id %>" ><img src="<%- prod.imagine %>" style="width:50%;height:auto;" alt="[imagine <%- prod.nume %>]" /></a>
                            </figure>
                        </div>
                        <p class="descriere">Descriere:<span class="val-descriere"><%- prod.descriere%></span></p>
                        <p class="categorie">Categorie:<span class="val-categorie"><%- prod.tip_produs%></span></p>
                        <p class="ambalaj">Ambalaj:<span class="val-ambalaj"><%- prod.tip_ambalaj%></span></p>
                        <p class="gramaj">Gramaj:<span class="val-gramaj"><%- prod.gramaj%></span></p>
                        <label class="selecteaza-cos">
                            Selectează:<br/>
                            <input type="checkbox" class="select-cos" value="<%-prod.id %>" autocomplete="off">
                        </label>
                    </article>
                <% }%>
            </div>
        </section>
    </main>
    
    <%- include("../fragmente/footer.ejs");  %> 

    </body>
</html>