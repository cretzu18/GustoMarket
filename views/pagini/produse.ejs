<!DOCTYPE html>
<html  lang="ro">
    <head>
        <title>Produse</title>

        <meta name="keywords" content="gust, ingrediente, ingrediente proaspete, produse bio, condimente, fructe, legume, carne, lactate, rețete, deserturi, deserturi fără zahăr">
        <meta name="description" content="La GustoMarket poți cumpăra cele mai proaspete ingrediente pentru a realiza cele mai delicioase rețete. Livrare la domiciliu doar în București!">
        <link rel="stylesheet" type="text/css" href="/resurse/css/produse.css">
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <%- include("../fragmente/head.ejs");  %> 
    </head>
    <body>
        
    <%- include("../fragmente/header.ejs");  %> 

    <main>
        <h2>Produse</h2>
        <div class="container mt-4">
            <form id="form-filtrare">
                <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nume</label>
                    <input type="text" id="inp-nume" list="nume-produse" class="form-control" />
                    <datalist id="nume-produse">
                    <% for (let prod of locals.produse) { %>
                        <option value="<%= prod.nume %>"></option>
                    <% } %>
                    </datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Țara de origine</label>
                    <input type="text" id="inp-tara" list="tara-produse" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Gramaj minim: <span id="infoRange">(0)</span></label>
                    <input type="range" id="inp-gramaj" value="0" min="0" max="1000" step="50" class="form-range">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Categorie produs</label>
                    <select id="inp-categorie" name="tip_produs" class="form-select">
                    <option value="oricare" selected>Oricare</option>
                    <option value="legume">Legume</option>
                    <option value="fructe">Fructe</option>
                    <option value="lactate">Lactate și ouă</option>
                    <option value="cereale">Pâine și cereale</option>
                    <option value="carne">Carne</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Tip ambalaj</label><br>
                    <div class="btn-group" role="group">
                    <% const ambalaje = ["vidat", "cutie", "punga", "sticla", "neambalat", "oricare"]; %>
                    <% ambalaje.forEach((amb) => { %>
                        <input type="radio" class="btn-check" name="tip_ambalaj" id="ambalaj_<%= amb %>" value="<%= amb %>" <%= amb === "oricare" ? "checked" : "" %>>
                        <label class="btn btn-outline-secondary" for="ambalaj_<%= amb %>"><%= amb.charAt(0).toUpperCase() + amb.slice(1) %></label>
                    <% }); %>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Perioada până la expirare</label>
                    <select id="inp-data-expirare" name="data-expirare" multiple class="form-select">
                    <option value="0-3">0-3 luni</option>
                    <option value="3-6">3-6 luni</option>
                    <option value="6-12">6-12 luni</option>
                    <option value="12+">Peste 12 luni</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Vegan</label><br>
                    <div class="btn-group" role="group">
                    <input id="vegan_toate" class="btn-check" type="radio" name="vegan" value="toate" checked>
                    <label class="btn btn-outline-secondary" for="vegan_toate">Toate</label>
                    <input id="vegan_da" class="btn-check" type="radio" name="vegan" value="da">
                    <label class="btn btn-outline-secondary" for="vegan_da">Da</label>
                    <input id="vegan_nu" class="btn-check" type="radio" name="vegan" value="nu">
                    <label class="btn btn-outline-secondary" for="vegan_nu">Nu</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating">
                    <textarea id="inp-caracteristici" class="form-control" placeholder="Caracteristici (ex: bio, proaspăt, etc.)"></textarea>
                    <label for="inp-caracteristici">Caracteristici</label>
                    <div class="invalid-feedback">
                        Caracteristicile introduse nu sunt valide.
                    </div>
                    </div>
                </div>
                </div>
            </form>
            </div>

            <div class="container mt-4">
                <div class="row g-2">
                    <div class="col-12 col-md-6 col-lg-3">
                    <button id="resetare" class="btn btn-danger w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-x-circle-fill"></i>
                        <span class="d-none d-sm-inline">Resetează</span>
                    </button>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                    <button id="sortCrescNume" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-arrow-up-right-circle-fill"></i>
                        <span class="d-none d-sm-inline">Sortează crescător după preț și nume</span>
                    </button>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                    <button id="sortDescrescNume" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-arrow-down-right-circle-fill"></i>
                        <span class="d-none d-sm-inline">Sortează descrescător</span>
                    </button>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                    <button id="calcSuma" class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-calculator-fill"></i>
                        <span class="d-none d-sm-inline">Calculează suma produselor selectate</span>
                    </button>
                    </div>
                </div>
            </div>
            <p id="p-suma"></p>

            <p id="mesajFaraProduse" style="display:none; color:red; font-weight:bold;">
            Nu există niciun produs potrivit filtrării.
            </p>

            <div class="grid-produse">
                <% for( let prod of locals.produse) { %>
                    <article class="produs" id="elem_<%- prod.id %>">
                        <h3 class="nume">Nume: <a href="/produs/<%-prod.id %>" ><span class="val-nume"><%- prod.nume%></span></a></h3>
                        <div class="container-info-img">
                            <table class="info-prod">
                                <tr>
                                    <th>Pret</th>
                                    <th><span class="val-pret"><%- prod.pret%></span></th>
                                </tr>
                                <tr>
                                    <th>Tara</th>
                                    <th><span class="val-tara"><%- prod.tara%></span></th>
                                </tr>
                                <tr>
                                    <th>Caracteristici</th>
                                    <th><span class="val-caracteristici"><%- prod.caracteristici%></span></th>
                                </tr>
                                <tr>
                                    <th>Data exiprare</th>
                                    <th>
                                        <time class="val-data-expirare" datetime="<%= prod.data_expirare %>">
                                            <script>
                                                function capitalize(str) {
                                                    return str.charAt(0).toUpperCase() + str.slice(1);
                                                }

                                                document.querySelectorAll('time.val-data-expirare').forEach(el => {
                                                    const dateStr = el.getAttribute('datetime');
                                                    if (dateStr) {
                                                    const date = new Date(dateStr);
                                                    if (!isNaN(date)) {
                                                        const zi = date.getDate();
                                                        const luna = date.toLocaleDateString('ro-RO', { month: 'long' });
                                                        const an = date.getFullYear();
                                                        const ziSapt = date.toLocaleDateString('ro-RO', { weekday: 'long' });
                                                        el.textContent = `${zi} ${capitalize(luna)} ${an} (${capitalize(ziSapt)})`;
                                                    } else {
                                                        el.textContent = 'N/A';
                                                    }
                                                    } else {
                                                    el.textContent = 'N/A';
                                                    }
                                                });
                                            </script>
                                        </time>
                                    </th>
                                </tr>
                                <tr>
                                    <th>Vegan</th>
                                    <th><span class="val-vegan"><%- prod.vegan ? "Da" : "Nu" %></span></th>
                                </tr>
                            </table>
                            <figure>
                                <a href="/produs/<%-prod.id %>" ><img src="<%- prod.imagine %>" style="width:50%;height:auto;" alt="[imagine <%- prod.nume %>]" /></a>
                            </figure>
                        </div>
                        <p class="descriere">Descriere:<span class="val-descriere"><%- prod.descriere%></span></p>
                        <p class="categorie">Categorie:<span class="val-categorie"><%- prod.tip_produs%></span></p>
                        <p class="ambalaj">Ambalaj:<span class="val-ambalaj"><%- prod.tip_ambalaj%></span></p>
                        <p class="gramaj">Gramaj:<span class="val-gramaj"><%- prod.gramaj%></span></p>
                        <button class="btn-compare" data-id="<%= prod.id %>" data-nume="<%= prod.nume %>">
                            Compară
                        </button>
                        <div class="selecteaza-produs" data-id="<%- prod.id %>">
                            <button class="btn-keep" title="Păstrează produsul">🔓</button>
                            <button class="btn-hide-temp" title="Ascunde temporar produsul">&#x1F5D1;</button>
                            <button class="btn-hide-perm" title="Ascunde definitiv produsul">&#x274C;</button>
                        </div>
                    </article>
                <% }%>
            </div>
        </section>
    </main>
    
    <%- include("../fragmente/footer.ejs");  %> 

    </body>
</html>