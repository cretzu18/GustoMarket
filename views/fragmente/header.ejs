<script src="/resurse/js/tema.js"></script>
<header class="c1" id="h1">
    <h1><a href="/index">Gusto Market</a></h1>
    <input id="ch-menu" type="checkbox">
    <label for="ch-menu" id="hamburger">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
    </label>
    <nav>
        <ul class="meniu">
            <li><a href="/index" class="fa-solid fa-house"></a><a href="/index" id="home">Acasă</a>
                <ul>
                    <li><a href="/index#welcome">Bine ați venit</a></li>
                    <li><a href="/index#retetele_saptamanii">Rețetele săptămânale</a></li>
                    <li><a href="/index#promotii">Promoții</a></li>
                    <li><a href="/index#galerie-statica">Galerie retete</a></li>
                </ul>
            </li>
            <li><div id="produse"><a href="/produse">Produse</a></div>
                <ul>
                    <% for (let opt of locals.optiuniMeniu) { %>
                        <li><a href="/produse?tip=<%= opt.unnest %>"><%= opt.unnest.toUpperCase() %></a></li>
                    <% }  %>
                </ul>
            </li>
            <li><a href="/despre">Despre noi</a></li>
            <li><a href="/inregistrare">Inregistrare</a></li>
        </ul>
    </nav>
    <div id="select-tema-wrapper">
        <label for="select_tema">Temă:</label>
        <select id="select_tema">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
            <option value="solarized">Solarized</option>
        </select>
    </div>
</header>